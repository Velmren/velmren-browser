# Local Windows x64 development build. Paths are relative to src/brave.
cache_dir=../../cache
# A full-history Git mirror defeats --no-history on a fresh checkout.
# Keep tool caches on E:, but fetch dependency repositories shallowly in place.
gclient_global_vars_cache_dir=null
lean_sync=true
use_remoteexec=false
use_brave_hermetic_toolchain=false
is_brave_origin_branded=false
gn_args_enable_brave_rewards=false
gn_args_enable_brave_ads=false
gn_args_enable_brave_wallet=false
gn_args_enable_ai_chat=false
gn_args_enable_local_ai=false
gn_args_enable_brave_vpn_v1=false
gn_args_enable_brave_vpn_v2=false
gn_args_enable_brave_news=false
gn_args_enable_brave_talk=false
gn_args_enable_tor=false
gn_args_enable_playlist=false
gn_args_enable_brave_stats_updater=false
gn_args_enable_web_discovery_native=false
gn_args_enable_web_discovery=false
gn_args_enable_brave_education=false
gn_args_enable_email_aliases=false
gn_args_enable_speedreader=false
gn_args_enable_brave_wayback_machine=false
gn_args_enable_psst=false
gn_args_enable_updater=false
gn_args_use_prebuilt_omaha4=false
gn_args_enable_update_notifications=false
gn_args_enable_crash_dialog=false
gn_args_symbol_level=1
gn_args_blink_symbol_level=0
gn_args_v8_symbol_level=0
gn_args_concurrent_links=1
