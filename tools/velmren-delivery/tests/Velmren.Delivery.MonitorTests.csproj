<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../DeliveryArchiveDependencies.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>Velmren.Delivery.MonitorTests</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.cs;MonitorTests.cs" />
    <EmbeddedResource Include="../DevelopmentPolicy.json" LogicalName="Velmren.DeliveryPolicy" />
    <EmbeddedResource Include="$(PinnedPublicKey)" LogicalName="Velmren.UpdatePublicKey" />
  </ItemGroup>
</Project>
