<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../DeliveryArchiveDependencies.props" Condition="'$(NativeDecoderTestVariant)' == ''" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>Velmren.Delivery.NativeDecoderTests</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RELEASE_DELIVERY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.cs;CompactArchiveTests.cs;NativeDecoderTests.cs" />
    <EmbeddedResource Include="../ReleasePolicy.github.json" LogicalName="Velmren.DeliveryPolicy" />
    <EmbeddedResource Include="../preview-public.pem" LogicalName="Velmren.UpdatePublicKey" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeDecoderTestVariant)' != ''">
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <EmbeddedResource Include="$(NativeDecoderTestImage)" LogicalName="Velmren.NativeArchiveDecoder" Condition="'$(NativeDecoderTestVariant)' == 'corrupt'" />
  </ItemGroup>
</Project>
