<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);FakeEngine/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Configuration" />
    <Compile Remove="FakeEngine/**/*.cs" />
    <Compile Include="../EngineRunner.cs" Link="EngineRunner.cs" />
    <Compile Include="../PayloadSession.cs" Link="PayloadSession.cs" />
    <Compile Include="../SetupOptions.cs" Link="SetupOptions.cs" />
    <Compile Include="../SetupForm.cs" Link="SetupForm.cs" />
    <Compile Include="../SetupControls.cs" Link="SetupControls.cs" />
    <Compile Include="../MaintenanceRelocation.cs" Link="MaintenanceRelocation.cs" />
    <Compile Include="../FrameworkCompatibility.cs" Link="FrameworkCompatibility.cs" />
    <Compile Include="../FrameworkApplication.cs" Link="FrameworkApplication.cs" />
    <Compile Include="../FolderPicker.cs" Link="FolderPicker.cs" />
    <EmbeddedResource Include="../../../app/theme/velmren/logo-preview.png" LogicalName="Setup.Brand.Logo" />
    <EmbeddedResource Include="../../../app/theme/brave/win/brave.ico" LogicalName="Setup.Brand.Icon" />
  </ItemGroup>
  <Import Project="$(SetupPayloadProps)" Condition="'$(SetupPayloadProps)' != ''" />
</Project>
