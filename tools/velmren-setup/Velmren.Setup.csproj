<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VelmrenSetup</AssemblyName>
    <RootNamespace>Velmren.Setup</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../app/theme/brave/win/brave.ico</ApplicationIcon>
    <Company>Velmren</Company>
    <Product>Velmren</Product>
    <Description>Установка Velmren</Description>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;bin/**/*.cs;obj/**/*.cs" />
    <EmbeddedResource Include="../../app/theme/velmren/logo-preview.png" LogicalName="Setup.Brand.Logo" />
    <EmbeddedResource Include="../../app/theme/brave/win/brave.ico" LogicalName="Setup.Brand.Icon" />
  </ItemGroup>
  <Import Project="$(SetupPayloadProps)" Condition="'$(SetupPayloadProps)' != ''" />
</Project>
