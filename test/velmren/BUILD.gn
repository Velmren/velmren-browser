import("//testing/test.gni")

if (is_win) {
  test("velmren_filter_unittests") {
    sources = [ "//brave/components/velmren/public_filters_unittest.cc" ]
    deps = [
      "//base/test:run_all_unittests",
      "//brave/components/velmren:public_filters",
      "//testing/gtest",
    ]
  }

  # Reuse Chromium's unchanged password tests and complete component test
  # initialization without building unrelated component test suites.
  test("velmren_password_unittests") {
    testonly = true

    sources = [ "imported_google_credentials_unittest.cc" ]

    deps = [
      "//base",
      "//base/test:test_support",
      "//components/affiliations/core/browser:affiliations",
      "//components/affiliations/core/browser:test_support",
      "//components/password_manager/core/browser",
      "//components/password_manager/core/browser:test_support",
      "//components/password_manager/core/browser:unit_tests",
      "//components/password_manager/core/browser/affiliation:affiliation_match_helper",
      "//components/password_manager/core/browser/password_store:password_store_impl",
      "//components/password_manager/core/browser/password_store:test_support",
      "//components/test:run_all_unittests",
      "//testing/gmock",
      "//testing/gtest",
      "//url",
    ]

    data = [ "//components/test/data/password_manager/" ]

    data_deps = [
      "//components:components_tests_pak",
      "//third_party/angle:includes",
      "//ui/resources:ui_test_pak_data",
    ]
  }
}
